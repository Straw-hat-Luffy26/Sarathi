# Node / React
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Rust / Tauri target builds
target/
src-tauri/target/
src-tauri/gen/

# Editor & OS files — .claude/settings.local.json is per-developer, not shared
.claude/settings.local.json
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.sln
*.sw?

# Temporary / Scratch
tmp/
*.tmp

# Python bytecode from the sidecars — regenerated on every run.
__pycache__/
*.pyc
.gstack/

# Toolchain installers people download into the repo root while setting up.
# They are multi-megabyte binaries that belong on the machine, not in history.
rustup-init.exe

# MCP registry and research data.
#
# These normally live in the app data folder, not here. They are listed anyway
# because mcp.json carries local service tokens and a copy dropped in the repo
# to try something out must not be committable. The same goes for a Python
# environment: the sidecars are written against the system interpreter, and a
# venv appearing here means something was set up the wrong way.
mcp.json
research/
.venv/
venv/
